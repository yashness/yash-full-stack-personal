# =============================================================================
# Root Environment Variables
# =============================================================================
# Copy to .env for docker-compose

# Production URLs (for docker-compose.prod.yml)
FRONTEND_URL=http://localhost:{{ cookiecutter.frontend_port }}
BACKEND_URL=http://localhost:{{ cookiecutter.backend_port }}

# Development URLs use domain-based routing via Traefik:
# FRONTEND_URL=https://{{ cookiecutter.project_slug }}.local
# BACKEND_URL=https://api-{{ cookiecutter.project_slug }}.local
