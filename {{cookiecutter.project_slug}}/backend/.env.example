# Security
SECRET_KEY=generate-a-secure-random-string

# Database
DATABASE_URL=mysql://user:password@db:3306/{{ cookiecutter.project_slug | replace('-', '_') }}

# Frontend URL for CORS
FRONTEND_URL=https://{{ cookiecutter.project_slug }}.local
