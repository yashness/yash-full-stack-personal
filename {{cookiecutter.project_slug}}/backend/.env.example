# =============================================================================
# Secrets - DO NOT COMMIT .env file
# =============================================================================

# Security
SECRET_KEY=generate-a-secure-random-string

# Database
DATABASE_URL=mysql://user:password@db:3306/{{ cookiecutter.project_slug | replace('-', '_') }}

# Frontend URL for CORS
FRONTEND_URL=https://{{ cookiecutter.project_slug }}.dev.test

# =============================================================================
# Clerk Authentication (optional - run `bun run setup:clerk` in frontend first)
# =============================================================================
# Get your keys from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_8gJB6j4KZAVoerpfdYF1qqiQOfUnNvJajMI3xw7ssA

# Webhook secret for verifying Clerk webhook signatures
# Set up webhooks at: https://dashboard.clerk.com/webhooks
# Endpoint URL: https://api-{{ cookiecutter.project_slug }}.dev.test/api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_RhtRvY27N5ZqIsm3pQ6cTJmbG6vADMVE

# =============================================================================
# Claude Agent SDK (required for Copilot UI)
# =============================================================================
# Option 1: Direct Anthropic API (for Claude Pro/API users)
# ANTHROPIC_API_KEY=sk-ant-...

# Option 2: Microsoft Foundry (Azure)
# Get key from: Azure Portal > AI Foundry > Endpoints and keys
CLAUDE_CODE_USE_FOUNDRY=1
ANTHROPIC_FOUNDRY_RESOURCE=yshah-0001-resource
ANTHROPIC_FOUNDRY_API_KEY=your-foundry-api-key-here
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-5
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-1
