# =============================================================================
# Frontend Environment Variables
# =============================================================================
# Copy to .env.local for local development

# Project Configuration
NEXT_PUBLIC_PROJECT_NAME="{{ cookiecutter.project_name }}"

# Backend API URL (base URL without /api/v1 - the API client adds the path)
NEXT_PUBLIC_API_URL=http://localhost:{{ cookiecutter.backend_port }}

# =============================================================================
# Feature Flags
# =============================================================================
# Enable/disable features at runtime. Set to "true" or "false".

# Core Features
NEXT_PUBLIC_FEATURE_COPILOT=true    # AI copilot chat interface
NEXT_PUBLIC_FEATURE_AUTH=true       # Authentication via Clerk

# Advanced AI Features
NEXT_PUBLIC_FEATURE_CANVAS=false       # Agentic canvas interface
NEXT_PUBLIC_FEATURE_FLOW_BUILDER=false # Visual flow builder
NEXT_PUBLIC_FEATURE_MCP_CREATOR=false  # MCP tool creator
NEXT_PUBLIC_FEATURE_SKILL_CREATOR=false # Skill/agent creator

# Business Features
NEXT_PUBLIC_FEATURE_PRICING=true    # Pricing/billing pages
NEXT_PUBLIC_FEATURE_ADMIN=false     # Admin dashboard

# =============================================================================
# Clerk Authentication (run `bun run setup:clerk` first to install components)
# =============================================================================
# Demo Clerk app keys - replace with your own from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2VydGFpbi1qYWd1YXItMTkuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_8gJB6j4KZAVoerpfdYF1qqiQOfUnNvJajMI3xw7ssA

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# =============================================================================
# AI/Copilot Configuration
# =============================================================================
# AI credentials are managed on the backend - no frontend config needed.
# The frontend proxies chat requests to the backend API.
